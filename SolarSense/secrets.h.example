// Copy this file to secrets.h and fill in your own values.
// secrets.h is git-ignored; this example file is not.
//
// config.h picks these up automatically via __has_include("secrets.h").
// If secrets.h is missing the firmware still runs -- WiFi simply reports
// NOT CONFIGURED and everything else carries on.
#pragma once

#define SS_WIFI_SSID     "MyNetwork"
#define SS_WIFI_PASSWORD "MyPassword"

// Full URL of the backend ingest endpoint. Leave as "" until the backend
// exists; the firmware reports "Backend: NOT CONFIGURED" rather than
// pretending to upload.
#define SS_BACKEND_URL "http://192.168.1.50:8000/api/sensors/data"

// Sent as the X-API-Key header when non-empty. Omit until the backend
// implements per-node authentication.
#define SS_BACKEND_API_KEY ""
